{
  "info": {
    "_postman_id": "a_steam-api-collection",
    "name": "A Steam API — Complete Collection",
    "description": "Complete Postman collection for the A Steam backend API (v1).\n\nBase URL: http://localhost:5000/api/v1\n\n## Setup\n1. Set the `base_url` collection variable to your server (default: http://localhost:5000/api/v1)\n2. Register a user and run the Login request — the `token` variable is auto-saved.\n3. For admin routes, log in with an admin account.\n\n## Variable Reference\n- `{{base_url}}` — API base URL\n- `{{token}}` — JWT Bearer token (auto-set on login)\n- `{{appid}}` — Steam App ID for game routes\n- `{{reviewId}}` — MongoDB review ObjectId\n- `{{userId}}` — MongoDB user ObjectId",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url", "value": "http://localhost:5000/api/v1", "type": "string" },
    { "key": "token",    "value": "",                              "type": "string" },
    { "key": "appid",    "value": "570",                          "type": "string" },
    { "key": "reviewId", "value": "",                             "type": "string" },
    { "key": "userId",   "value": "",                             "type": "string" }
  ],
  "item": [

    {
      "name": "🔐 Authentication",
      "item": [
        {
          "name": "Register User",
          "request": {
            "method": "POST", "url": "{{base_url}}/auth/register",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"Vishwa Patel\",\n  \"email\": \"vishwa@example.com\",\n  \"password\": \"Password123\"\n}" }
          }
        },
        {
          "name": "Login User",
          "event": [{ "listen": "test", "script": { "exec": ["const r = pm.response.json();", "if (r.data && r.data.token) pm.collectionVariables.set('token', r.data.token);"], "type": "text/javascript" } }],
          "request": {
            "method": "POST", "url": "{{base_url}}/auth/login",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"vishwa@example.com\",\n  \"password\": \"Password123\"\n}" }
          }
        },
        {
          "name": "Logout User",
          "request": {
            "method": "POST", "url": "{{base_url}}/auth/logout",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }]
          }
        },
        {
          "name": "Get Profile (GET /profile)",
          "request": {
            "method": "GET", "url": "{{base_url}}/auth/profile",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }]
          }
        },
        {
          "name": "Get Profile (GET /me)",
          "request": {
            "method": "GET", "url": "{{base_url}}/auth/me",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }]
          }
        },
        {
          "name": "Update Profile (PATCH /profile)",
          "request": {
            "method": "PATCH", "url": "{{base_url}}/auth/profile",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }, { "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"Vishwa B Patel\",\n  \"bio\": \"Steam enthusiast\"\n}" }
          }
        },
        {
          "name": "Change Password (PATCH)",
          "request": {
            "method": "PATCH", "url": "{{base_url}}/auth/change-password",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }, { "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"currentPassword\": \"Password123\",\n  \"newPassword\": \"NewPassword456\"\n}" }
          }
        },
        {
          "name": "Change Password (POST)",
          "request": {
            "method": "POST", "url": "{{base_url}}/auth/change-password",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }, { "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"currentPassword\": \"Password123\",\n  \"newPassword\": \"NewPassword456\"\n}" }
          }
        },
        {
          "name": "Forgot Password",
          "request": {
            "method": "POST", "url": "{{base_url}}/auth/forgot-password",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"vishwa@example.com\"\n}" }
          }
        },
        {
          "name": "Reset Password",
          "request": {
            "method": "POST", "url": "{{base_url}}/auth/reset-password",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"token\": \"PASTE_RESET_TOKEN_FROM_SERVER_LOGS\",\n  \"newPassword\": \"NewPassword789\"\n}" }
          }
        },
        {
          "name": "Verify Email",
          "request": {
            "method": "POST", "url": "{{base_url}}/auth/verify-email",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"token\": \"PASTE_EMAIL_VERIFICATION_TOKEN\"\n}" }
          }
        },
        {
          "name": "Send OTP",
          "request": {
            "method": "POST", "url": "{{base_url}}/auth/send-otp",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"vishwa@example.com\"\n}" }
          }
        }
      ]
    },

    {
      "name": "🎮 Games — Basic CRUD",
      "item": [
        {
          "name": "Get All Games",
          "request": { "method": "GET", "url": { "raw": "{{base_url}}/games", "host": ["{{base_url}}"], "path": ["games"] } }
        },
        {
          "name": "Get All Games (Paginated)",
          "request": { "method": "GET", "url": { "raw": "{{base_url}}/games?page=1&limit=10", "host": ["{{base_url}}"], "path": ["games"], "query": [{ "key": "page", "value": "1" }, { "key": "limit", "value": "10" }] } }
        },
        {
          "name": "Get Game by AppID",
          "request": { "method": "GET", "url": "{{base_url}}/games/{{appid}}" }
        },
        {
          "name": "Create Game (Admin)",
          "request": {
            "method": "POST", "url": "{{base_url}}/games",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }, { "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"Test Game\",\n  \"description\": \"A test game entry\",\n  \"price\": 19.99,\n  \"isFree\": false,\n  \"genre\": [\"Action\", \"Adventure\"],\n  \"developer\": [\"Test Studio\"],\n  \"publisher\": [\"Test Publisher\"],\n  \"platforms\": { \"windows\": true, \"mac\": false, \"linux\": true },\n  \"tags\": [\"multiplayer\", \"co-op\"],\n  \"releaseDate\": \"2024-01-01\"\n}" }
          }
        },
        {
          "name": "Replace Game (PUT — Admin)",
          "request": {
            "method": "PUT", "url": "{{base_url}}/games/{{appid}}",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }, { "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"Updated Game Name\",\n  \"price\": 24.99,\n  \"description\": \"Fully replaced game entry\"\n}" }
          }
        },
        {
          "name": "Partial Update Game (PATCH — Admin)",
          "request": {
            "method": "PATCH", "url": "{{base_url}}/games/{{appid}}",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }, { "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"price\": 9.99\n}" }
          }
        },
        {
          "name": "Delete Game (Admin)",
          "request": {
            "method": "DELETE", "url": "{{base_url}}/games/{{appid}}",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }]
          }
        },
        {
          "name": "Check Game Exists",
          "request": { "method": "GET", "url": "{{base_url}}/games/exists/{{appid}}" }
        },
        {
          "name": "Get Game Summary",
          "request": { "method": "GET", "url": "{{base_url}}/games/{{appid}}/summary" }
        },
        {
          "name": "Get Game History (Admin)",
          "request": {
            "method": "GET", "url": "{{base_url}}/games/{{appid}}/history",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }]
          }
        },
        {
          "name": "Archive Game (Admin)",
          "request": {
            "method": "PATCH", "url": "{{base_url}}/games/{{appid}}/archive",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }]
          }
        },
        {
          "name": "Restore Game (Admin)",
          "request": {
            "method": "PATCH", "url": "{{base_url}}/games/{{appid}}/restore",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }]
          }
        },
        {
          "name": "Get Related Games",
          "request": { "method": "GET", "url": "{{base_url}}/games/{{appid}}/related" }
        },
        {
          "name": "Get Random Game",
          "request": { "method": "GET", "url": "{{base_url}}/games/random" }
        }
      ]
    },

    {
      "name": "📋 Games — Information",
      "item": [
        { "name": "Get Screenshots",         "request": { "method": "GET", "url": "{{base_url}}/games/{{appid}}/screenshots" } },
        { "name": "Get Trailers",             "request": { "method": "GET", "url": "{{base_url}}/games/{{appid}}/trailers" } },
        { "name": "Get System Requirements", "request": { "method": "GET", "url": "{{base_url}}/games/{{appid}}/system-requirements" } },
        { "name": "Get DLC List",             "request": { "method": "GET", "url": "{{base_url}}/games/{{appid}}/dlc" } },
        { "name": "Get Achievements",         "request": { "method": "GET", "url": "{{base_url}}/games/{{appid}}/achievements" } },
        { "name": "Get Leaderboards",         "request": { "method": "GET", "url": "{{base_url}}/games/{{appid}}/leaderboards" } },
        { "name": "Get Game Updates",         "request": { "method": "GET", "url": "{{base_url}}/games/{{appid}}/updates" } },
        { "name": "Get Game News",            "request": { "method": "GET", "url": "{{base_url}}/games/{{appid}}/news" } }
      ]
    },

    {
      "name": "⭐ Reviews",
      "item": [
        {
          "name": "Get Game Reviews",
          "request": { "method": "GET", "url": "{{base_url}}/games/{{appid}}/reviews" }
        },
        {
          "name": "Add Review",
          "request": {
            "method": "POST", "url": "{{base_url}}/games/{{appid}}/reviews",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }, { "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"rating\": 4.5,\n  \"comment\": \"Excellent game, highly recommend!\"\n}" }
          }
        },
        {
          "name": "Update Review",
          "request": {
            "method": "PATCH", "url": "{{base_url}}/games/{{appid}}/reviews/{{reviewId}}",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }, { "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"rating\": 5,\n  \"comment\": \"Updated: Even better after 10 hours!\"\n}" }
          }
        },
        {
          "name": "Delete Review",
          "request": {
            "method": "DELETE", "url": "{{base_url}}/games/{{appid}}/reviews/{{reviewId}}",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }]
          }
        }
      ]
    },

