        { "name": "Filter by Rating",      "request": { "method": "GET", "url": { "raw": "{{base_url}}/games?rating=4",      "query": [{ "key": "rating",    "value": "4" }] } } },
        { "name": "Filter by Release Year","request": { "method": "GET", "url": { "raw": "{{base_url}}/games?releaseYear=2024","query": [{ "key": "releaseYear","value": "2024" }] } } },
        { "name": "Filter Discounted",     "request": { "method": "GET", "url": { "raw": "{{base_url}}/games?discount=true",  "query": [{ "key": "discount",  "value": "true" }] } } },
        { "name": "Filter Multiplayer",    "request": { "method": "GET", "url": { "raw": "{{base_url}}/games?multiplayer=true","query": [{ "key": "multiplayer","value": "true" }] } } },
        { "name": "Filter Free to Play",   "request": { "method": "GET", "url": { "raw": "{{base_url}}/games?freeToPlay=true","query": [{ "key": "freeToPlay","value": "true" }] } } }
      ]
