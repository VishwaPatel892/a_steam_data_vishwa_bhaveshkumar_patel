    {
      "name": "🔍 Query Parameters & Filtering",
      "item": [
        { "name": "Filter by Genre",       "request": { "method": "GET", "url": { "raw": "{{base_url}}/games?genre=action",     "query": [{ "key": "genre",     "value": "action" }] } } },
        { "name": "Filter by Developer",   "request": { "method": "GET", "url": { "raw": "{{base_url}}/games?developer=valve", "query": [{ "key": "developer", "value": "valve" }] } } },
        { "name": "Filter by Publisher",   "request": { "method": "GET", "url": { "raw": "{{base_url}}/games?publisher=ea",    "query": [{ "key": "publisher", "value": "ea" }] } } },
        { "name": "Filter by Platform",    "request": { "method": "GET", "url": { "raw": "{{base_url}}/games?platform=windows","query": [{ "key": "platform",  "value": "windows" }] } } },
